{
  "name": "html-to-text",
  "version": "10.0.0",
  "description": "Advanced html to plain text converter",
  "keywords": [
    "html",
    "node",
    "text",
    "mail",
    "plain",
    "converter"
  ],
  "license": "MIT",
  "author": "Malte Legenhausen <legenhausen@werk85.de>",
  "contributors": [
    "KillyMXI <killy@mxii.eu.org>"
  ],
  "homepage": "https://github.com/html-to-text/node-html-to-text",
  "repository": {
    "type": "git",
    "url": "git://github.com/html-to-text/node-html-to-text.git"
  },
  "bugs": {
    "url": "https://github.com/html-to-text/node-html-to-text/issues"
  },
  "type": "module",
  "main": "./lib/html-to-text.cjs",
  "module": "./lib/html-to-text.mjs",
  "exports": {
    "types": "./types/index.d.ts",
    "import": "./lib/html-to-text.mjs",
    "require": "./lib/html-to-text.cjs"
  },
  "types": "./types/index.d.ts",
  "typesVersions": {
    "*": {
      "lib/block-text-builder": [
        "types/lib/block-text-builder.d.ts"
      ]
    }
  },
  "files": [
    "lib",
    "types",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:rollup": "rollup -c",
    "build:types": "tsc -p tsconfig.types.json",
    "build": "npm run clean && npm run build:rollup && npm run build:types && npm run copy:license",
    "clean": "rimraf lib types",
    "copy:license": "copyfiles -f ../../LICENSE .",
    "cover": "c8 --reporter=lcov --reporter=text-summary mocha -t 20000 --extension ts",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "mocha --extension ts"
  },
  "dependencies": {
    "@selderee/plugin-htmlparser2": "^0.11.0",
    "deepmerge": "^4.3.1",
    "dom-serializer": "^2.0.0",
    "htmlparser2": "^10.0.0",
    "selderee": "^0.11.0"
  }
}
